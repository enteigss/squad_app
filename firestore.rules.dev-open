rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT ONLY - WIDE OPEN RULES
    // WARNING: These rules allow ANY authenticated user to read/write EVERYTHING
    // Only deploy to test environment: linkup-bu-test-environment
    // NEVER deploy to production!

    match /{document=**} {
      // Allow all reads and writes for ANYONE (no authentication required)
      allow read, write: if true;
    }
  }
}
