rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is participant in a post
    function isParticipant(postData) {
      return isAuthenticated() && request.auth.uid in postData.participantIds;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated(); // Allow reading other users for features
      allow create: if isOwner(userId);
      // Allow user to update their own data except email verification fields
      allow update: if isOwner(userId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isEmailVerified', 'verifiedEmail']);
      // Allow updating blockedByUserIds when someone blocks/unblocks this user
      allow update: if isAuthenticated() &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedByUserIds']);
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.auth.uid == request.resource.data.authorId;
      allow update: if isAuthenticated() && 
                       (isOwner(resource.data.authorId) || 
                        isParticipant(resource.data) ||
                        request.auth.uid in request.resource.data.participantIds);
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.authorId);
    }

    // Post chat messages (subcollection of posts)
    match /posts/{postId}/chat/{messageId} {
      allow read: if isAuthenticated() &&
        (isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.authorId) ||
         isParticipant(get(/databases/$(database)/documents/posts/$(postId)).data));
      allow create: if isAuthenticated() &&
        isParticipant(get(/databases/$(database)/documents/posts/$(postId)).data);
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.senderId);
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.senderId);
    }

    // SMS invites collection - for tracking sent invites
    match /sms_invites/{inviteId} {
      allow read: if isAuthenticated() && 
                     (isOwner(resource.data.inviterId) || 
                      request.auth.uid in resource.data.recipients);
      allow create: if isAuthenticated() && 
                       isOwner(request.resource.data.inviterId);
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.inviterId);
    }

    // Analytics collections removed - now using Firebase Analytics instead of Firestore

    // Party invitations (existing functionality)
    match /party_invitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }

    // User preferences
    match /user_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Groups/Squads
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                       (isOwner(resource.data.createdBy) || 
                        request.auth.uid in resource.data.members);
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.createdBy);
    }

    // Group messages
    match /groups/{groupId}/messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.senderId);
    }

    // Meetup feedback collection
    match /meetup_feedback/{feedbackId} {
      allow read: if isAuthenticated() && 
                     request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated(); // Temporary: allow any authenticated user
      allow update: if isAuthenticated() && 
                       request.auth.uid == resource.data.userId;
      allow delete: if false; // Feedback should not be deletable
    }

    // Pending feedback prompts collection
    match /pending_feedback_prompts/{promptId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated(); // Allow authenticated users to create prompts
      allow update: if isAuthenticated() && 
                       isOwner(resource.data.userId); // For marking as shown
      allow delete: if isAuthenticated() && 
                       isOwner(resource.data.userId); // For cleanup after submission
    }

    // Blocks collection - for user blocking functionality
    match /blocks/{blockId} {
      // Users can only create blocks where they are the blocker
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.blockerId;
      // Users can read their own blocks (as blocker)
      allow read: if isAuthenticated() &&
                     request.auth.uid == resource.data.blockerId;
      // Users can delete their own blocks (unblocking)
      allow delete: if isAuthenticated() &&
                       request.auth.uid == resource.data.blockerId;
      // No updates allowed - only create/delete for blocking
      allow update: if false;
    }

    // Reports collection - for content reporting
    match /reports/{reportId} {
      // Any authenticated user can create reports
      allow create: if isAuthenticated();
      // Only the reporter can read their own reports
      allow read: if isAuthenticated() &&
                     request.auth.uid == resource.data.reporterInfo.uid;
      // No updates or deletes allowed for reports
      allow update, delete: if false;
    }

    // Test emails
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}